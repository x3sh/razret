   <TabItem Header="Соединение"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10"><TextBlock Text="Стратегии" FontSize="21" FontWeight="SemiBold"/></DockPanel>
