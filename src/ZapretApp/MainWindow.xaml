      <DataGridTextColumn Header="DISCORD" Binding="{Binding Discord}" Width="67"/>
      <DataGridTextColumn Header="YOUTUBE" Binding="{Binding Youtube}" Width="67"/>
      
      
     <DataGridTextColumn Header="ОТКЛИК" Binding="{Binding Response}" Width="70"/></DataGrid.Columns>
    </DataGrid></Border>
    <StackPanel Grid.Row="2" Margin="2,10,2,0">
