 </Window.Resources>
 <Grid Background="{DynamicResource Canvas}"><Grid Margin="20,20,20,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <Button x:Name="MenuButton" DockPanel.Dock="Right" Padding="12,9" Margin="0" Click="MenuClick" AutomationProperties.Name="Меню приложения">
    <Button.Content><Path Data="{StaticResource IconMenu}" Style="{StaticResource MenuIcon}" Width="19" Height="19"/></Button.Content><Button.ContextMenu><ContextMenu><MenuItem Header="Соединение" Tag="0" Click="Navigate"><MenuItem.Icon><Path Data="{StaticResource IconHome}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem><Separator/><MenuItem Header="Настройки" Tag="1" Click="Navigate"><MenuItem.Icon><Path Data="{StaticResource IconSettings}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem><MenuItem Header="Обновления" Tag="2" Click="Navigate"><MenuItem.Icon><Path Data="{StaticResource IconUpdate}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem><MenuItem Header="Диагностика" Tag="3" Click="Navigate"><MenuItem.Icon><Path Data="{StaticResource IconPulse}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem><Separator/><MenuItem Header="Свернуть в трей" Click="HideClick"><MenuItem.Icon><Path Data="{StaticResource IconTray}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem><MenuItem Header="Выйти и выключить обход" Click="ExitClick"><MenuItem.Icon><Path Data="{StaticResource IconPower}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon></MenuItem></ContextMenu></Button.ContextMenu>
   </Button>
