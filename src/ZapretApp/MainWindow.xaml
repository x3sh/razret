     <Button x:Name="DetailsButton" Content="Подробнее о стратегии" Click="DetailsClick" Background="Transparent" Foreground="{DynamicResource Muted}" HorizontalAlignment="Left" FontSize="11" Padding="4,8" Margin="0,5,0,0"/><Popup x:Name="SelectedExpander" Placement="Top" PlacementTarget="{Binding ElementName=DetailsButton}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="18" Padding="18" Width="420" Margin="0,0,0,8"><StackPanel><TextBlock Text="Результаты проверки" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="SelectedDetails" TextWrapping="Wrap" FontSize="12" Margin="0,0,8,0"/></ScrollViewer><Button x:Name="SingleButton" Content="Повторить проверку" Click="SingleClick" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border></Popup>
    </StackPanel>
   </Grid></TabItem>
   <TabItem Header="Настройки"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="2,0,2,10">
    <DockPanel Margin="0,0,0,12"><Button Click="HomeClick" Padding="10,8" ToolTip="К соединению" AutomationProperties.Name="К соединению"><Path Data="{StaticResource IconBack}" Style="{StaticResource MenuIcon}"/></Button><TextBlock Text="Настройки" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="18"><StackPanel>
     <TextBlock Text="Оформление" FontWeight="SemiBold"/><ComboBox x:Name="ThemeBox" SelectionChanged="ThemeChanged"><ComboBoxItem Content="Тёмная" Tag="dark"/><ComboBoxItem Content="Светлая" Tag="light"/><ComboBoxItem Content="Как в Windows" Tag="system"/></ComboBox>
     <StackPanel Orientation="Horizontal"><CheckBox x:Name="StartupBox" Content="Запускать вместе с Windows"/><Button Style="{StaticResource Help}" Click="HelpClick" Tag="Создаёт личную задачу Windows: через 20 секунд после входа запускает Razret с правами администратора в трее и включает сохранённую стратегию. Для настройки один раз нужны права администратора. Пароль не сохраняется. Сначала подберите рабочую стратегию. Перемещение папки приложения нарушит автозапуск — после переноса отключите и включите настройку снова."/></StackPanel>
     <CheckBox x:Name="AutoConnectBox" Content="Подключаться при открытии"/>
     <StackPanel Orientation="Horizontal"><CheckBox x:Name="TrayBox" Content="Продолжать работу после закрытия окна"/><Button Style="{StaticResource Help}" Click="HelpClick" Tag="Крестик скрывает окно, обход продолжает работать. Значок Razret находится рядом с часами или в скрытых значках Windows. Двойной щелчок открывает окно. Для полной остановки выберите «Выйти и выключить обход» в меню приложения или значка."/></StackPanel>
     <CheckBox x:Name="UpdatesBox" Content="Проверять обновления при открытии"/>
     <Expander x:Name="AdvancedExpander" Header="Дополнительно" Margin="0,14,0,18"><StackPanel Margin="0,10,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="Игровой фильтр" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Style="{StaticResource Help}" Click="HelpClick" Tag="Расширяет обработку трафика на порты 1024–65535. UDP часто используется в играх и голосовой связи, TCP — в загрузках и других соединениях. Начните с «Выключен». Включайте нужный режим, если конкретная игра не работает, и повторите подбор. Фильтр может повлиять на другие приложения; работа всех игр не гарантируется."/></StackPanel>
     <ComboBox x:Name="GameBox"><ComboBoxItem Content="Выключен · рекомендуется начать с этого" Tag="off"/><ComboBoxItem Content="Только TCP" Tag="tcp"/><ComboBoxItem Content="Только UDP" Tag="udp"/><ComboBoxItem Content="TCP и UDP" Tag="all"/></ComboBox>
     <StackPanel Orientation="Horizontal"><TextBlock Text="Фильтр IP-адресов" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Style="{StaticResource Help}" Click="HelpClick" Tag="IPSet определяет охват дополнительных правил по IP. «Только домены» отключает этот охват; основные правила Discord и YouTube остаются. «Адреса из списка» использует список проекта. «Все адреса» расширяет обработку на любые IP и может мешать другим приложениям. После изменения повторите подбор."/></StackPanel>
     <ComboBox x:Name="IpsetBox"><ComboBoxItem Content="Только домены · IPSet выключен" Tag="none"/><ComboBoxItem Content="Адреса из списка проекта" Tag="loaded"/><ComboBoxItem Content="Все адреса · расширенный режим" Tag="any"/></ComboBox>
     <TextBlock Text="Изменение фильтров остановит текущий обход. После сохранения подберите стратегию заново." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,10,0,15"/><Button Content="Пользовательские списки" Click="ListsClick" HorizontalAlignment="Left"/></StackPanel></Expander>
     <WrapPanel><Button x:Name="SaveButton" Content="Сохранить" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" Click="SaveClick"/></WrapPanel>
    </StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Обновления"><DockPanel LastChildFill="True">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,15"><Button Click="HomeClick" Padding="10,8" ToolTip="К соединению" AutomationProperties.Name="К соединению"><Path Data="{StaticResource IconBack}" Style="{StaticResource MenuIcon}"/></Button><TextBlock Text="Обновления" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Background="{DynamicResource Surface}" CornerRadius="12" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="Обновления Razret" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="AppUpdateText" Text="Проверяйте новые версии приложения здесь. Установка выполняется по вашей кнопке." Foreground="{DynamicResource Muted}" Margin="0,12,0,14"/><WrapPanel><Button x:Name="AppCheckButton" Content="Проверить Razret" Click="AppCheckClick"/><Button x:Name="AppInstallButton" Content="Обновить и перезапустить" Click="AppInstallClick" IsEnabled="False"/></WrapPanel><TextBlock x:Name="AppReleaseNotes" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,12,0,0"/></StackPanel></Border><Border Background="{DynamicResource Surface}" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="Обновления обхода" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="UpdateText" Text="Проверим новую версию, сохраним ваши списки и заменим движок. Предыдущая версия останется для отката." Foreground="{DynamicResource Muted}" Margin="0,12,0,20"/><WrapPanel><Button x:Name="CheckButton" Content="Проверить" Click="CheckClick"/><Button x:Name="UpdateButton" Content="Скачать и применить" IsEnabled="False" Click="UpdateClick"/><Button x:Name="LaterButton" Content="Остаться на текущей" Visibility="Collapsed" Click="LaterClick"/></WrapPanel><TextBlock Text="Что изменилось · кратко на русском" FontWeight="SemiBold" Margin="0,18,0,8"/><ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ReleaseNotes" Text="Появятся после проверки обновлений." FontSize="12" Foreground="{DynamicResource Muted}"/></ScrollViewer><TextBlock Text="Движок zapret обновляется отдельно от приложения Razret." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,20,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
   </DockPanel></TabItem>
   <TabItem Header="Диагностика"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel DockPanel.Dock="Top" Margin="0,0,0,15"><Button Click="HomeClick" Padding="10,8" ToolTip="К соединению" AutomationProperties.Name="К соединению"><Path Data="{StaticResource IconBack}" Style="{StaticResource MenuIcon}"/></Button><TextBlock Text="Диагностика" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><WrapPanel Grid.Row="1" Margin="0,0,0,15"><Button x:Name="DiagnoseButton" Content="Проверить состояние" Click="DiagnoseClick"/><Button Content="Открыть журнал" Click="LogClick"/></WrapPanel><TextBox x:Name="DiagnosticsText" Foreground="{DynamicResource Text}" Grid.Row="2" Padding="14" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="{DynamicResource Surface}" FontFamily="Consolas" FontSize="12" Text="Диагностика не меняет службы, DNS и hosts."/></Grid></TabItem>
  </TabControl>
  <TextBlock Grid.Row="3" x:Name="Footer" Text="" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,12,0,0"/>
 <Popup x:Name="HelpPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"><Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="16" Margin="0,5,0,0" MaxWidth="350"><TextBlock x:Name="HelpText" Foreground="{DynamicResource Text}" TextWrapping="Wrap" FontSize="12" LineHeight="18"/></Border></Popup>
 </Grid></Grid>
</Window>
