   <Button x:Name="AppNotice" DockPanel.Dock="Right" Visibility="Collapsed" Click="AppNoticeClick" FontSize="11" Padding="10,7" Background="{DynamicResource Notice}"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{StaticResource BrandIcon}" Width="38" Height="38"/><StackPanel Margin="11,0,14,0"><TextBlock Text="razret" FontSize="27" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="VersionLabel" Visibility="Collapsed"/></StackPanel>
  </DockPanel>
    <Border x:Name="StrategyCard" Grid.Row="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="24" Padding="20,18" Margin="0,0,0,18"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=Pages}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel>
     <DockPanel Margin="0,0,0,12"><Border x:Name="CardBadge" DockPanel.Dock="Right" Background="{DynamicResource Badge}" CornerRadius="8" Padding="8,4"><StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="{DynamicResource BadgeText}" Margin="0,0,5,0"/><TextBlock x:Name="SelectionStatus" Foreground="{DynamicResource BadgeText}" FontSize="10"/></StackPanel></Border><TextBlock x:Name="CardCaption" Text="СОХРАНЁННАЯ СТРАТЕГИЯ" FontSize="9" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="HeroTitle" Visibility="Collapsed"/></DockPanel>
     <DockPanel><Button x:Name="ToggleButton" DockPanel.Dock="Right" Content="Включить" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" Click="ToggleClick" Padding="16,11" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"><Button.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPower}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource AccentText}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0"/><TextBlock Text="{Binding}" Foreground="{DynamicResource AccentText}"/></StackPanel></DataTemplate></Button.ContentTemplate></Button><StackPanel><TextBlock x:Name="SelectionTitle" Text="Начнём с настройки" FontWeight="SemiBold" FontSize="30" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock x:Name="CardSubtitle" Text="Стратегия подключения" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></DockPanel>
     <UniformGrid x:Name="MetricsGrid" Columns="3" Margin="0,17,0,0">
      <Border Background="{DynamicResource MetricSurface}" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,6,0"><StackPanel><TextBlock x:Name="CardPingLabel" Text="Ping сервисов" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="CardPing" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Background="{DynamicResource MetricSurface}" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,6,0"><StackPanel><TextBlock x:Name="CardResponseLabel" Text="Отклик" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="CardResponse" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Background="{DynamicResource MetricSurface}" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10"><StackPanel><TextBlock x:Name="CardPassedLabel" Text="Проверки" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="CardPassed" Text="—" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
     </UniformGrid>
     <TextBlock x:Name="TestTimestamp" Foreground="{DynamicResource Muted}" FontSize="10" Margin="1,10,0,0"/>
     <TextBlock x:Name="WelcomeText" Visibility="Collapsed" Text="Разрешите запуск, затем нажмите «Подобрать автоматически». Razret проверит стратегии и сохранит подходящую для вашей сети." Foreground="{DynamicResource Muted}" FontSize="12" LineHeight="19" Margin="0,14,0,8"/>
     
     
     <WrapPanel><Button x:Name="AdminButton" Content="Разрешить запуск" ToolTip="Нужны права администратора для включения обхода" Click="Elevate" FontSize="11" Padding="10,7"/><Button x:Name="CancelButton" Content="Отменить проверку" Click="CancelClick" Visibility="Collapsed" FontSize="11" Padding="10,7"/></WrapPanel>
     <TextBlock x:Name="ModeLabel" Visibility="Collapsed"/><TextBlock x:Name="StatusTitle" Visibility="Collapsed"/>
     <TextBlock x:Name="StatusDetail" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,9,0,0" FontSize="11"/>
     <ProgressBar x:Name="Progress" Visibility="Collapsed" Height="3" Minimum="0" Maximum="100" Foreground="{DynamicResource Accent}" Background="{DynamicResource Border}" Margin="0,9,0,0"/>
    </StackPanel></Border>
