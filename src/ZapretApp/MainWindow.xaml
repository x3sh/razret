   <Border x:Name="MetricsGrid" Background="{DynamicResource MetricSurface}" CornerRadius="8" Padding="8,10" Margin="0,12,0,0"><UniformGrid Columns="3"><Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,0" Padding="6,0"><Grid x:Name="MetricPingGroup" HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><local:AppIcon Data="{StaticResource IconWifi}" Style="{StaticResource MenuIcon}" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/><StackPanel Grid.Column="1"><TextBlock x:Name="CardPingLabel" Text="Пинг" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="CardPing" Text="—" FontSize="18" FontWeight="Medium" Margin="0,3,0,0"/></StackPanel></Grid></Border><Border BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0" Padding="6,0"><Grid x:Name="MetricResponseGroup" HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><local:AppIcon Data="{StaticResource IconClock}" Style="{StaticResource MenuIcon}" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/><StackPanel Grid.Column="1"><TextBlock x:Name="CardResponseLabel" Text="Отклик" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="CardResponse" Text="—" FontSize="18" FontWeight="Medium" Margin="0,3,0,0"/></StackPanel></Grid></Border><Border BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0" Padding="6,0"><Grid x:Name="MetricPassedGroup" HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><local:AppIcon Data="{StaticResource IconChecks}" Style="{StaticResource MenuIcon}" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/><StackPanel Grid.Column="1"><TextBlock x:Name="CardPassedLabel" Text="Проверки" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="CardPassed" Text="—" FontSize="18" FontWeight="Medium" Margin="0,3,0,0"/></StackPanel></Grid></Border></UniformGrid></Border>
   <TextBlock x:Name="WelcomeText" Visibility="Collapsed" Foreground="{DynamicResource Muted}" FontSize="12" LineHeight="18" Margin="0,12,0,0"/>
   <WrapPanel x:Name="AdminPanel" Margin="0,12,0,0"><Button x:Name="AdminButton" Content="Разрешить запуск" ToolTip="Нужны права администратора для включения обхода" Click="Elevate" FontSize="12" Padding="10,6" Margin="0"/></WrapPanel>
  </StackPanel></Border>
  <Border x:Name="BusyPanel" Grid.Row="3" Visibility="Collapsed" Background="{DynamicResource Surface}" CornerRadius="10" Padding="12" Margin="0,0,0,14"><StackPanel><TextBlock x:Name="StatusDetail" FontSize="12"/><ProgressBar x:Name="Progress" Height="3" Minimum="0" Maximum="100" Foreground="{DynamicResource Accent}" Background="{DynamicResource Border}" Margin="0,10,0,0"/><Button x:Name="UpdateCancelButton" Content="Отменить" Click="CancelClick" Margin="0,12,0,0" HorizontalAlignment="Left" Padding="12,7"/></StackPanel></Border>
  <TabControl Grid.Row="4" x:Name="Pages" SelectionChanged="PageChanged" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Text}" Padding="0">
   <TabItem Header="Соединение"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel x:Name="StrategiesHeader" Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="AutoButton" Content="Подобрать" Click="AutoClick" Padding="12,7" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" ToolTip="Проверить стратегии и включить лучшую"/>
     <Button x:Name="CancelButton" Content="Отменить" Click="CancelClick" Visibility="Collapsed" Padding="10,6"/>
     <Button x:Name="ViewModeButton" Click="ToggleStrategyView" Padding="7" Margin="0,0,6,0" ToolTip="Показать плашками" AutomationProperties.Name="Переключить вид стратегий"><local:AppIcon x:Name="ViewModeIcon" Data="{StaticResource IconGrid}" Style="{StaticResource MenuIcon}" Width="16" Height="16"/></Button>
     <Button x:Name="StrategiesToggleButton" Click="ToggleStrategiesVisibility" Padding="7" Margin="0" ToolTip="Свернуть стратегии" AutomationProperties.Name="Свернуть стратегии"><local:AppIcon x:Name="StrategiesChevron" Data="{StaticResource IconChevron}" Style="{StaticResource MenuIcon}" Width="16" Height="16" RenderTransformOrigin="0.5,0.5"/></Button>
    </StackPanel><TextBlock Text="Стратегии" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <Border x:Name="ResultsPanel" Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="6"><ListBox x:Name="ResultsGrid" MouseDoubleClick="StrategyDoubleClick" SelectionChanged="StrategySelected" BorderThickness="0" Background="Transparent" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" Padding="0,0,4,0" HorizontalContentAlignment="Stretch" ItemsPanel="{StaticResource StrategyListPanel}" ItemTemplate="{StaticResource StrategyListTemplate}" ItemContainerStyle="{StaticResource StrategyRow}"/></Border>
    <DockPanel x:Name="StrategyActions" Grid.Row="2" Margin="0,12,0,0"><Button x:Name="BackToActiveButton" DockPanel.Dock="Right" Content="К активной" Click="BackToActiveClick" FontSize="12" Padding="9,6" Visibility="Collapsed" Margin="0"/><TextBlock x:Name="SelectedProfileText" Visibility="Collapsed"/><Button x:Name="ManualButton" Content="Использовать" Click="ManualClick" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" Padding="10,6"/><Button x:Name="DetailsButton" Visibility="Collapsed" Content="Подробности" Click="DetailsClick" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Muted}" FontSize="12" Padding="6" HorizontalAlignment="Left" Margin="0"/></DockPanel>
    <Popup x:Name="SelectedExpander" Placement="Top" PlacementTarget="{Binding ElementName=ResultsGrid}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12" Width="400" Margin="0,0,0,8"><StackPanel><TextBlock Text="Результаты проверки" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="SelectedDetails" FontSize="12" Margin="0,0,8,0"/></ScrollViewer><Button x:Name="SingleButton" Content="Повторить проверку" Click="SingleClick" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border></Popup>
   </Grid></TabItem>
   <TabItem Header="Настройки"><DockPanel><Button x:Name="SaveButton" Content="Сохранить настройки" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" Click="SaveClick" HorizontalAlignment="Left" Margin="0,12,0,0" DockPanel.Dock="Bottom"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,8">
    <DockPanel Margin="0,0,0,12"><Button Click="HomeClick" Padding="7" ToolTip="К соединению"><local:AppIcon Data="{StaticResource IconBack}" Style="{StaticResource MenuIcon}"/></Button><TextBlock Text="Настройки" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="Оформление" FontSize="12" Foreground="{DynamicResource Muted}" FontWeight="SemiBold"/><ComboBox x:Name="ThemeBox" SelectionChanged="ThemeChanged" Margin="0,12,0,0"><ComboBoxItem Content="Тёмная" Tag="dark"/><ComboBoxItem Content="Светлая" Tag="light"/><ComboBoxItem Content="Как в Windows" Tag="system"/></ComboBox></StackPanel></Border>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="Подключение и запуск" FontSize="12" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource Help}" Click="HelpClick" Tag="Запускает Razret с правами администратора в трее через 20 секунд после входа в Windows и включает сохранённую стратегию. Сначала подберите рабочую стратегию. После перемещения папки выключите и включите настройку заново."/><CheckBox x:Name="StartupBox"><TextBlock FontSize="12.5" Text="Запускать вместе с Windows"/></CheckBox></DockPanel>
     <DockPanel><Border DockPanel.Dock="Right" Width="36"/><CheckBox x:Name="AutoConnectBox"><TextBlock FontSize="12.5" Text="Подключаться при открытии"/></CheckBox></DockPanel>
    </StackPanel></Border>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="Работа в фоне" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>     <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource Help}" Click="HelpClick" Tag="Крестик скрывает окно, обход продолжает работать. Значок Razret находится рядом с часами или в скрытых значках. Для полной остановки выберите «Выйти и выключить обход» в меню."/><CheckBox x:Name="TrayBox"><TextBlock FontSize="12.5" Text="Продолжать работу в трее"/></CheckBox></DockPanel></StackPanel></Border>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="Обновления" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
     <DockPanel><Border DockPanel.Dock="Right" Width="36"/><CheckBox x:Name="UpdatesBox"><TextBlock FontSize="12.5" Text="Проверять обновления zapret при открытии"/></CheckBox></DockPanel>
     <TextBlock Text="О новых версиях Razret сообщаем отдельно. Установка обновлений — по вашей кнопке." Foreground="{DynamicResource Muted}" FontSize="11" LineHeight="16" Margin="0,6,0,0"/>
    </StackPanel></Border>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="Статистика качества" FontSize="12" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource Help}" Click="HelpClick" Tag="Результаты проверок, технические коды ошибок и итоги обновлений. Случайный постоянный код связывает отчёты одной установки. Без истории включений, точного времени действий, имени компьютера и содержимого трафика. Отправка добровольная. Выключение удаляет код и неотправленные отчёты; сервер хранит отчёты до 90 дней."/><CheckBox x:Name="StatisticsBox" Checked="StatisticsChanged" Unchecked="StatisticsChanged"><TextBlock FontSize="12.5" Text="Помогать улучшать Razret"/></CheckBox></DockPanel>
     <WrapPanel x:Name="StatisticsIdentityPanel" Visibility="Collapsed" Margin="0,8,0,0"><TextBlock x:Name="StatisticsCode" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Margin="0,0,12,6"/><Button Content="Скопировать код" Click="CopyStatisticsCode" Padding="10,7" Margin="0,0,0,6" FontSize="12"/></WrapPanel>
    </StackPanel></Border>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12"><Expander x:Name="AdvancedExpander" Header="Дополнительно"><StackPanel Margin="0,12,0,0">
     <StackPanel Orientation="Horizontal"><TextBlock Text="Игровой фильтр" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Style="{StaticResource Help}" Click="HelpClick" Tag="Расширяет обработку трафика на порты 1024–65535. Начните с выключенного фильтра. Если конкретная игра не работает, выберите нужный режим и повторите подбор. Фильтр может влиять на другие приложения."/></StackPanel>
     <ComboBox x:Name="GameBox"><ComboBoxItem Content="Выключен" Tag="off"/><ComboBoxItem Content="Только TCP" Tag="tcp"/><ComboBoxItem Content="Только UDP" Tag="udp"/><ComboBoxItem Content="TCP и UDP" Tag="all"/></ComboBox>
     <StackPanel Orientation="Horizontal"><TextBlock Text="Фильтр IP-адресов" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Style="{StaticResource Help}" Click="HelpClick" Tag="IPSet определяет охват дополнительных правил по IP. «Только домены» сохраняет основные правила Discord и YouTube. «Все адреса» может влиять на другие приложения. После изменения повторите подбор."/></StackPanel>
     <ComboBox x:Name="IpsetBox"><ComboBoxItem Content="Только домены" Tag="none"/><ComboBoxItem Content="Адреса из списка проекта" Tag="loaded"/><ComboBoxItem Content="Все адреса" Tag="any"/></ComboBox>
     <TextBlock Text="Изменение фильтров остановит обход. После сохранения подберите стратегию заново." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,14"/><Button Content="Пользовательские списки" Click="ListsClick" HorizontalAlignment="Left" Margin="0"/>
    <WrapPanel Margin="0,12,0,0"><Button Content="Диагностика" Click="DiagnosticsClick"/><Button Content="Свернуть в трей" Click="HideClick"/></WrapPanel><Button Content="Выйти и выключить обход" Click="ExitClick" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Expander></Border>
   </StackPanel></ScrollViewer></DockPanel></TabItem>
   <TabItem Header="Обновления"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button Click="HomeClick" Padding="7" ToolTip="К соединению"><local:AppIcon Data="{StaticResource IconBack}" Style="{StaticResource MenuIcon}"/></Button><TextBlock Text="Обновления" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <ScrollViewer x:Name="UpdatesScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,8">
     <Border x:Name="AppUpdateSection" Background="{DynamicResource Surface}" CornerRadius="10" Padding="12" Margin="0,0,0,12"><StackPanel><DockPanel><TextBlock x:Name="AppVersionText" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="Приложение Razret" FontSize="17" FontWeight="SemiBold"/></DockPanel><TextBlock x:Name="AppUpdateText" Text="Установка сохраняет настройки и выбранную стратегию." Foreground="{DynamicResource Muted}" Margin="0,12,0,14" FontSize="12"/><WrapPanel><Button x:Name="AppCheckButton" Content="Проверить" Click="AppCheckClick" Margin="0,0,8,8"/><Button x:Name="AppInstallButton" Content="Обновить и перезапустить" Click="AppInstallClick" IsEnabled="False" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="AppReleaseNotes" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel></Border>
     <Border x:Name="EngineUpdateSection" Background="{DynamicResource Surface}" CornerRadius="10" Padding="12"><StackPanel><DockPanel><TextBlock x:Name="EngineVersionText" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="Движок zapret" FontSize="17" FontWeight="SemiBold"/></DockPanel><TextBlock x:Name="UpdateText" Text="Обновляется отдельно от Razret. Списки сохраняются, предыдущая версия остаётся для отката." Foreground="{DynamicResource Muted}" Margin="0,12,0,14" FontSize="12"/><WrapPanel><Button x:Name="CheckButton" Content="Проверить" Click="CheckClick" Margin="0,0,8,8"/><Button x:Name="UpdateButton" Content="Скачать и применить" Click="UpdateClick" IsEnabled="False" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" Margin="0,0,0,8"/><Button x:Name="LaterButton" Content="Позже" Click="LaterClick" Visibility="Collapsed" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="Что изменилось" FontWeight="SemiBold" Margin="0,12,0,8" FontSize="12"/><TextBlock x:Name="ReleaseNotes" Text="Появится после проверки обновлений." FontSize="12" Foreground="{DynamicResource Muted}"/></StackPanel></Border>
    </StackPanel></ScrollViewer></DockPanel></TabItem>
   <TabItem Header="Диагностика"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button Click="HomeClick" Padding="7" ToolTip="К соединению"><local:AppIcon Data="{StaticResource IconBack}" Style="{StaticResource MenuIcon}"/></Button><TextBlock Text="Диагностика" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><WrapPanel Grid.Row="1" Margin="0,0,0,14"><Button x:Name="DiagnoseButton" Content="Проверить состояние" Click="DiagnoseClick" Margin="0,0,8,6"/><Button Content="Открыть журнал" Click="LogClick" Margin="0,0,0,6"/></WrapPanel><TextBox x:Name="DiagnosticsText" Grid.Row="2" Padding="12" Foreground="{DynamicResource Text}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="{DynamicResource Surface}" FontFamily="Consolas" FontSize="12" Text="Диагностика не меняет службы, DNS и hosts."/></Grid></TabItem>
  </TabControl>
  <StackPanel Grid.Row="5" Margin="0,10,0,0"><TextBlock x:Name="Footer" MaxHeight="64" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="0,10,0,0"><DockPanel><Button x:Name="UpdateBadge" DockPanel.Dock="Right" Click="UpdateBadgeClick" Background="Transparent" BorderThickness="0" Margin="0" Padding="6" ToolTip="Обновления приложения и движка" AutomationProperties.Name="Обновления"><Grid><local:AppIcon Data="{StaticResource IconUpdate}" Style="{StaticResource MenuIcon}" Width="18" Height="18"/><Ellipse x:Name="UpdateDot" Width="6" Height="6" Fill="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed"/><TextBlock x:Name="UpdateBadgeText" Visibility="Collapsed"/></Grid></Button><Button x:Name="FooterSettingsButton" Click="SettingsClick" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Margin="0" Padding="4,6"><StackPanel Orientation="Horizontal"><local:AppIcon Data="{StaticResource IconSettings}" Style="{StaticResource MenuIcon}" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="Настройки" FontSize="13" Foreground="{DynamicResource Muted}"/></StackPanel></Button></DockPanel></Border></StackPanel>
  <Popup x:Name="HelpPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,5,0,0" MaxWidth="350"><TextBlock x:Name="HelpText" FontSize="12" LineHeight="18"/></Border></Popup>
 </Grid></Grid>
</Window>
