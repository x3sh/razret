<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>Razret</AssemblyName><Version>0.7.11</Version><Product>Razret</Product><Title>Razret</Title>
    <ApplicationIcon>Assets/razret.ico</ApplicationIcon>
    <UpdateRepository Condition="'$(UpdateRepository)' == ''">x3sh/razret</UpdateRepository>
    <StatisticsEndpoint Condition="'$(StatisticsEndpoint)' == ''">https://razret-statistics.vercel.app/api/collect</StatisticsEndpoint>
  </PropertyGroup>
  <ItemGroup><Using Remove="System.Windows.Forms"/><Using Remove="System.Drawing"/></ItemGroup>
  <ItemGroup><AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" /></ItemGroup>
  <ItemGroup><AssemblyMetadata Include="StatisticsEndpoint" Value="$(StatisticsEndpoint)" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../THIRD-PARTY/Lucide-LICENSE.txt" LogicalName="Razret.LucideLicense"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/razret.ico" LogicalName="Razret.TrayIcon"/></ItemGroup>
  <ItemGroup><Resource Include="Assets/Fonts/*.ttf"/><EmbeddedResource Include="../../THIRD-PARTY/Inter-LICENSE.txt" LogicalName="Razret.InterLicense"/></ItemGroup>
  <ItemGroup><Resource Include="Assets/razret-icon.png"/><Content Include="Assets/razret.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true"/></ItemGroup>
</Project>
